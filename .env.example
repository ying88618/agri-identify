# 复制为 .env 后填入真实值：  copy .env.example .env   (Windows) / cp .env.example .env
# 本文件只放键名与安全的默认值，不含任何密钥；.env 已被 .gitignore 忽略。

# ---- LLM / 向量化 / 重排（OpenAI 兼容接口）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
MODEL_NAME=
VL_MODEL_NAME=
EMBEDDING_MODEL=BAAI/bge-m3
# 换 rerank 模型后必须重新标定 core/config.py 的 DEFAULT_SCORE_THRESHOLD，
# 否则误报率会隐性漂移（两模型的分数尺度不同）。
RERANK_MODEL=

# ---- 联网搜索兜底 ----
TAVILY_API_KEY=

# ---- 存储 ----
MILVUS_URI=http://localhost:19530
# 与 docker-compose.yml 中 redis 的宿主端口对应（6379 常被其它服务占用，故用 6380）
REDIS_URL=redis://localhost:6380/0
CHAT_HISTORY_TTL=1800

# ---- 鉴权 ----
# 生成方式：python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_DAYS=7

# 用 127.0.0.1 明确走 TCP；密码含 @ : / # 时必须 URL 编码
DATABASE_URL=mysql+pymysql://agri:<password>@127.0.0.1:3306/agri_agent?charset=utf8mb4